APP_NAME=triebwerk
LOG_CHANNEL=triebwerk
ENVIRONMENT=development
PUBLIC_IP=
# the master server: lists the servers, knows the players, keeps the scores
MASTER_URL=http://localhost:8081
# what the master asks game servers for, if it was given a SERVER_KEY
SERVER_KEY=
# name in the list of servers, by default "<REGION> <PUBLIC_IP>:<PORT>"
SERVER_NAME=
PORT=9090
MAX_PLAYERS=12
GAME_LENGTH=600
# files of a certificate for PUBLIC_IP: TLS for the WebSocket and WebTransport on the same port (UDP)
TLS_CERT=
TLS_KEY=
# WebTransport with a certificate the server makes itself, for development (Chromium accepts it by its hash)
WEBTRANSPORT_SELF_SIGNED=false

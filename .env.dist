APP_NAME=triebwerk
LOG_CHANNEL=triebwerk
ENVIRONMENT=development
PUBLIC_IP=
MASTER_URL=http://localhost:8081
PORT=9090
MAX_PLAYERS=12
GAME_LENGTH=300
# files of a certificate for PUBLIC_IP: TLS for the WebSocket and WebTransport on the same port (UDP)
TLS_CERT=
TLS_KEY=
# WebTransport with a certificate the server makes itself, for development (Chromium accepts it by its hash)
WEBTRANSPORT_SELF_SIGNED=false
